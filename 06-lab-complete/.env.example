# ============================================================
# Biến môi trường của agent. Dùng: cp .env.example .env rồi sửa giá trị.
# File .env đã nằm trong .gitignore — KHÔNG commit secret thật.
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
# Số uvicorn worker trong Docker (CMD đọc biến này, mặc định 2)
WEB_CONCURRENCY=2

# Security — bắt buộc đặt, tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=replace-with-a-long-random-key

# Redis (rate limit + cost guard). Trong docker compose: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request / 60 giây cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Cost guard (USD) — vượt → 402
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
